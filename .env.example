# Local PostgreSQL runtime connection. Use the restricted kurata_app role.
DATABASE_URL=postgresql://kurata_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kurata_dev

# Isolated test database. Never point tests at kurata_dev.
DATABASE_TEST_URL=postgresql://kurata_app:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kurata_test

# Used only by Drizzle migrations. Do not expose this value to the browser.
DATABASE_MIGRATION_URL=postgresql://kurata_owner:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kurata_dev

# Use this value only in DBeaver for safe, read-only inspection.
DBEAVER_READONLY_URL=postgresql://kurata_readonly:REPLACE_WITH_LOCAL_PASSWORD@localhost:5432/kurata_dev
